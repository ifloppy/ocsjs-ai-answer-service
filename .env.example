# 认证模式：推荐官方 SIWC 共享符合资格的 ChatGPT 计划额度，无需单独 API Key
# 1. python siwc_login.py （在浏览器中授权）
# 2. 将 AUTH_MODE 设置为 siwc
# 3. 使用 openssl rand -hex 24 生成下面本地访问密钥
AUTH_MODE=siwc
ACCESS_TOKEN=REPLACE_WITH_YOUR_RANDOM_LOCAL_ACCESS_TOKEN
# OAuth 凭据默认存于 ~/.config/ocsjs-ai-answer-service/siwc.json（不放进仓库）
# SIWC_AUTH_FILE=~/.config/ocsjs-ai-answer-service/siwc.json

# 如需改用单独付费的官方或兼容 API，请设置 AUTH_MODE=api_key，并填写密钥
# OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODE=responses

# 服务默认仅本机可访问
HOST=127.0.0.1
PORT=5000
DEBUG=False

# 模型以 python siwc_models.py 显示的实际可用列表为准
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium

# SIWC 强制 store=False、stream=True，且不发送 service_tier/max_output_tokens
OPENAI_STORE=False
OPENAI_STREAM=True
OPENAI_SERVICE_TIER=
MAX_OUTPUT_TOKENS=500

ENABLE_CACHE=True
CACHE_EXPIRATION=86400
LOG_LEVEL=INFO
